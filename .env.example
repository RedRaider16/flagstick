# Copy to .env.local for local development. Never commit real values of anything
# other than the two public settings below.

# Path the site is served under. GitHub Pages project sites use /<repo-name>/.
VITE_BASE_PATH=/flagstick/

# Connected mode (optional). Leave both blank to run in demo mode only.
# Supabase Dashboard -> Project Settings -> API Keys.
#   URL:              https://<project-ref>.supabase.co
#   Publishable key:  sb_publishable_...   (safe in the browser; RLS protects data)
# NEVER put a secret key (sb_secret_...) or the legacy service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
